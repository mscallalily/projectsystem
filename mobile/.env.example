# Base URL of the PASS Laravel API (no trailing slash, no /api suffix).
# - Android emulator talking to `php artisan serve` on your PC:  http://10.0.2.2:8000
# - Physical phone / Expo Go: use your computer's LAN IP, e.g.   http://192.168.1.20:8000
#   (start the API with `php artisan serve --host=0.0.0.0 --port=8000`)
EXPO_PUBLIC_API_URL=http://192.168.1.20:8000
