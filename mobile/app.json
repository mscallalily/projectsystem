{
  "expo": {
    "name": "PASS Mobile",
    "slug": "pass-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "passmobile",
    "splash": {
      "backgroundColor": "#0B1F3A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.projectsystem.passmobile"
    },
    "android": {
      "package": "com.projectsystem.passmobile",
      "permissions": ["CAMERA"]
    },
    "plugins": [
      "expo-secure-store",
      ["expo-camera", { "cameraPermission": "Allow PASS Mobile to scan parking QR codes." }],
      "expo-sqlite"
    ]
  }
}
